# ============================================================
# vehicletracker — environment variables template
# Copy this file to .env and fill in real values
# ============================================================

# Django core
DJANGO_SECRET_KEY=your-secret-key-here
PROJECT_ENVIRONMENT=dev           # set to anything other than "dev" for production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ---- Database (leave blank to use SQLite fallback) ----------
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=

# ---- Redis / Celery -------------------------------------------
REDIS_PATH=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- TWINS real-time API -------------------------------------
TWINS_API_URL=
TWINS_API_TOKEN=
TWINS_VENDOR=intangles
TWINS_SPV=UMT
TWINS_LIMIT=5

# Per-project TWINS overrides
TWINS_MBMT_VENDOR=intangles
TWINS_MBMT_SPV=MBMT
TWINS_NAGPUR_VENDOR=eka
TWINS_NAGPUR_SPV=nagpur

# ---- Telemetry / historical API ------------------------------
TELEMETRY_API_URL=
TELEMETRY_API_KEY=

# ---- Voltrack internal API -----------------------------------
VOLTRACK_API_BASE_URL=
VOLTRACK_API_TOKEN=
VOLTRACK_VENDOR=intangles

# ---- Vehicle master ------------------------------------------
VEHICLE_DATABASE_URL=
VEHICLE_MASTER_TABLE=Vehicle_Master2

# ---- Notification services (optional) -----------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL_ALERT=
WEBHOOK_URL=
WEBHOOK_API_KEY=
WEBHOOK_ENABLED=false
WEBHOOK_TIMEOUT=10
WEBHOOK_RETRY_COUNT=3
WEBHOOK_VENDOR_NAME=
WEBHOOK_EVENT_PAGE_URL=
WEBHOOKS_TOKEN=

# ---- Jira / CNS (optional) -----------------------------------
JIRA_API_TOKEN=
JIRA_DOMAIN=
JIRA_EMAIL=
CNS_ACCESS_KEY=
CNS_BASE_URL=

# ---- SmartFastAPI (optional) ---------------------------------
SMARTFASTAPI_DOMAIN=
SMARTFASTAPI_ACCESS_KEY=
PROCESSED_API_TOKEN=
PROCESSED_API_BASE_URL=

# ---- Microsoft SSO (optional) --------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=

# ---- reCAPTCHA (optional) ------------------------------------
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# ---- Static / media paths ------------------------------------
STATIC_ROOT=staticfiles
MEDIA_ROOT=media
RAW_DATA_ROOT=data/raw

# ---- Vendor display names (JSON, optional) ------------------
# VENDOR_DISPLAY_NAMES={"intangles": "IN", "iplt": "IP"}
# COMMON_VENDORS=["intangles", "iplt"]

# ---- Log levels (optional) -----------------------------------
ROOT_LOG_LEVEL=WARNING
DJANGO_LOG_LEVEL=WARNING
LIVETRACKER_LOG_LEVEL=DEBUG
MIS_LOG_LEVEL=DEBUG
